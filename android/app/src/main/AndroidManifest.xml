<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Talking to laptops over Wi-Fi, and finding them (mDNS + network check). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- So laptops can browse and get photos, videos and music (asked for in Settings). -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <!-- The floating assistant bubble and its microphone. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Optional, granted from a computer (adb): lets copies on the phone reach the laptops with no tap. -->
    <uses-permission android:name="android.permission.READ_LOGS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Staying ready to receive from laptops while the app is closed. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- "Received report.pdf" notifications (Android 13+ asks the user). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Start receiving again after a restart, without opening the app. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Lets the app ask (once, with the user's OK) not to be paused by battery saving. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LanShare">

        <!-- Ask Play services to fetch the QR scanner at install time, not on first scan. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode_ui" />

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Appear in every app's Share menu for files of any type. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>

        <!-- The assistant, opened from the floating bubble. Its own task, so it shows over
             whatever app is open and doesn't bring the home screen along. -->
        <activity
            android:name=".AssistantActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity=".assistant"
            android:theme="@style/Theme.LanShare.Assistant"
            android:windowSoftInputMode="adjustResize" />

        <!-- Invisible for a split second: reads what was just copied in another app. -->
        <activity
            android:name=".ClipReadActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=".clipread"
            android:theme="@style/Theme.LanShare.Invisible" />

        <!-- "Notify my laptops when I copy on this phone": switched on once in Accessibility. -->
        <service
            android:name=".ClipAccessibility"
            android:exported="false"
            android:label="@string/clip_accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/clip_accessibility" />
        </service>

        <!-- The Copy button on "Copied on NIKHIL-PC". -->
        <receiver
            android:name=".Clip$CopyReceiver"
            android:exported="false" />

        <!-- Accept / Decline buttons on the "wants to send" notification. -->
        <receiver
            android:name=".Approvals$Answer"
            android:exported="false" />

        <!-- Hands files opened from another device (in our cache) to the viewer app, read-only. -->
        <provider
            android:name=".CacheProvider"
            android:authorities="${applicationId}.cache"
            android:exported="false"
            android:grantUriPermissions="true" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".ReceiveService"
            android:exported="false"
            android:foregroundServiceType="specialUse|microphone">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Receives files sent by the user's own paired computers on the local Wi-Fi network" />
        </service>
    </application>
</manifest>
